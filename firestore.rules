rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function isFriend(uid) { return signedIn() && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid))); }
    function profileOf(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    // Who may read someone's profile and watched list: the owner, accepted friends (if visibility is friends/public), anyone signed in (if public).
    // blocked(uid): the owner of uid has blocked the person asking.
    function blocked(uid) { return exists(/databases/$(database)/documents/users/$(uid)/blocks/$(request.auth.uid)); }
    function canView(uid) {
      return isOwner(uid) || (signedIn() && !blocked(uid) && (profileOf(uid).visibility == 'public' || (profileOf(uid).visibility == 'friends' && isFriend(uid))));
    }

    function validPinned(p) {
      return p is map
        && p.keys().hasOnly(['type', 'id', 'title', 'year', 'poster', 'text'])
        && p.type in ['movie', 'tv'] && p.id is int
        && p.title is string && p.title.size() <= 200
        && p.text is string && p.text.size() <= 280
        && (p.poster == null || (p.poster is string && p.poster.size() <= 200 && p.poster.matches('^https://image\\.tmdb\\.org/.*')));
    }
    function shortText(v) { return v is string && v.size() <= 80; }
    function validInfo(i) {
      return i is map && i.keys().hasOnly(['movie', 'series', 'director', 'actor', 'watching', 'city'])
        && (!('movie' in i) || shortText(i.movie)) && (!('series' in i) || shortText(i.series))
        && (!('director' in i) || shortText(i.director)) && (!('actor' in i) || shortText(i.actor))
        && (!('watching' in i) || shortText(i.watching)) && (!('city' in i) || shortText(i.city));
    }
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'handle', 'photo', 'bio', 'visibility', 'pinned', 'tastes', 'info', 'updatedAt'])
        && (!('info' in d) || d.info == null || validInfo(d.info))
        && d.name is string && d.name.size() <= 40
        && d.visibility in ['private', 'friends', 'public']
        && (!('handle' in d) || d.handle == null || (d.handle is string && d.handle.matches('^[a-z0-9_]{3,20}$')))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() <= 24000 && d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && (!('pinned' in d) || d.pinned == null || validPinned(d.pinned))
        && (!('tastes' in d) || d.tastes == null || (d.tastes is map && d.tastes.keys().hasOnly(['genres', 'type']) && d.tastes.genres is list && d.tastes.genres.size() <= 8 && d.tastes.type in ['movie', 'tv', 'both']));
    }
    function validSeen(d) {
      return d.keys().hasOnly(['type', 'id', 'title', 'year', 'poster', 'rating', 'review', 'spoiler', 'updatedAt'])
        && d.keys().hasAll(['type', 'id', 'title', 'updatedAt'])
        && d.type in ['movie', 'tv'] && d.id is int
        && d.title is string && d.title.size() <= 200
        && (!('year' in d) || (d.year is string && d.year.size() <= 4))
        && (!('poster' in d) || d.poster == null || (d.poster is string && d.poster.size() <= 200 && d.poster.matches('^https://image\\.tmdb\\.org/.*')))
        && (!('rating' in d) || d.rating == null || (d.rating is number && d.rating >= 0.5 && d.rating <= 5 && math.floor(d.rating * 2) == d.rating * 2))
        && (!('spoiler' in d) || d.spoiler is bool)
        && (!('review' in d) || (d.review is string && d.review.size() <= 600))
        && d.updatedAt is number;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || (signedIn() && !blocked(uid) && (resource.data.visibility == 'public' || (resource.data.visibility == 'friends' && isFriend(uid))));
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);

      // Watched titles with rating and review.
      match /seen/{key} {
        allow read: if canView(uid);
        allow create, update: if isOwner(uid) && validSeen(request.resource.data);
        allow delete: if isOwner(uid);

        // Likes on this post: one per person, the doc id is the person's uid.
        match /likes/{liker} {
          allow read: if canView(uid);
          allow create: if isOwner(liker) && canView(uid)
            && request.resource.data.keys().hasOnly(['at', 'name'])
            && request.resource.data.at is number
            && request.resource.data.name is string && request.resource.data.name.size() <= 40;
          allow delete: if isOwner(liker);
        }
        // Comments on this post: written by anyone who can see it; the author or the post owner can delete.
        match /comments/{cid} {
          allow read: if canView(uid);
          allow create: if signedIn() && canView(uid)
            && request.resource.data.keys().hasOnly(['from', 'name', 'handle', 'text', 'at'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.handle is string && request.resource.data.handle.size() <= 20
            && request.resource.data.at is number;
          allow delete: if signedIn() && (resource.data.from == request.auth.uid || isOwner(uid));
        }
      }

      // Photo / text posts. Photos are small JPEGs stored inline (no paid storage).
      match /posts/{key} {
        allow read: if canView(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['text', 'photo', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() <= 900000 && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && (request.resource.data.text.size() > 0 || request.resource.data.photo != null)
          && request.resource.data.at is number;
        allow delete: if isOwner(uid);

        // Likes on this post: one per person, the doc id is the person's uid.
        match /likes/{liker} {
          allow read: if canView(uid);
          allow create: if isOwner(liker) && canView(uid)
            && request.resource.data.keys().hasOnly(['at', 'name'])
            && request.resource.data.at is number
            && request.resource.data.name is string && request.resource.data.name.size() <= 40;
          allow delete: if isOwner(liker);
        }
        // Comments on this post: written by anyone who can see it; the author or the post owner can delete.
        match /comments/{cid} {
          allow read: if canView(uid);
          allow create: if signedIn() && canView(uid)
            && request.resource.data.keys().hasOnly(['from', 'name', 'handle', 'text', 'at'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.handle is string && request.resource.data.handle.size() <= 20
            && request.resource.data.at is number;
          allow delete: if signedIn() && (resource.data.from == request.auth.uid || isOwner(uid));
        }
      }

      // Want to watch.
      match /watchlist/{key} {
        allow read: if canView(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'id', 'title', 'year', 'poster', 'at'])
          && request.resource.data.type in ['movie', 'tv'] && request.resource.data.id is int
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.year is string && request.resource.data.year.size() <= 4
          && (request.resource.data.poster == null || (request.resource.data.poster is string && request.resource.data.poster.size() <= 200 && request.resource.data.poster.matches('^https://image\\.tmdb\\.org/.*')))
          && request.resource.data.at is number;
        allow delete: if isOwner(uid);
      }

      // Notifications: anyone signed in (and not blocked) can leave one; only the owner reads them or marks them read.
      match /notifs/{nid} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow create: if signedIn() && request.auth.uid != uid && !blocked(uid)
          && request.resource.data.keys().hasOnly(['type', 'from', 'name', 'handle', 'title', 'key', 'col', 'text', 'at', 'read'])
          && request.resource.data.type in ['like', 'comment', 'repost', 'request', 'accept']
          && request.resource.data.from == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.handle is string && request.resource.data.handle.size() <= 20
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
          && (!('key' in request.resource.data) || (request.resource.data.key is string && request.resource.data.key.size() <= 40))
          && (!('col' in request.resource.data) || request.resource.data.col in ['seen', 'posts'])
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 140))
          && request.resource.data.at is number && request.resource.data.read == false;
      }

      // People I blocked: only I can see and change this list.
      match /blocks/{other} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && other != uid
          && request.resource.data.keys().hasOnly(['at', 'name', 'handle'])
          && request.resource.data.at is number
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.handle is string && request.resource.data.handle.size() <= 20;
      }

      // Reposts: someone else's post shared on my feed (only if that person's profile is not private).
      match /reposts/{rid} {
        allow read: if canView(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'ownerHandle', 'item', 'at'])
          && request.resource.data.owner is string && request.resource.data.owner != uid
          && profileOf(request.resource.data.owner).visibility in ['friends', 'public']
          && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 40
          && request.resource.data.ownerHandle is string && request.resource.data.ownerHandle.size() <= 20
          && validSeen(request.resource.data.item)
          && request.resource.data.at is number;
        allow delete: if isOwner(uid);
      }
    }

    // Nickname -> uid lookup (also used by the search box). A nickname can be claimed once and never overwritten.
    // Public mini card: only name, nickname and photo, so people can be found and suggested even with a private profile.
    match /cards/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'handle', 'photo', 'discover', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (request.resource.data.handle == null || (request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')))
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() <= 24000 && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && request.resource.data.discover is bool
        && request.resource.data.updatedAt is number;
      allow delete: if isOwner(uid);
    }

    // Shared cache of TMDB backdrop image paths used by the background themes.
    match /meta/backdrops {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['paths', 'updatedAt'])
        && request.resource.data.paths is map && request.resource.data.paths.size() <= 200
        && request.resource.data.updatedAt is number;
    }

    // Reports of posts and comments. Nobody can read them from the app; check them in the Firebase console.
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'owner', 'col', 'key', 'comment', 'reason', 'text', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 128
        && request.resource.data.col in ['seen', 'posts', 'comment']
        && request.resource.data.key is string && request.resource.data.key.size() <= 60
        && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 60))
        && request.resource.data.reason in ['spam', 'offensive', 'spoilers', 'other']
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 300))
        && request.resource.data.at is number;
    }

    // A TMDB key shared with every signed-in user. Only the person who shared it can change or remove it.
    match /meta/tmdb {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['key', 'owner', 'at'])
        && request.resource.data.key is string && request.resource.data.key.size() >= 16 && request.resource.data.key.size() <= 400
        && request.resource.data.at is number;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['key', 'owner', 'at'])
        && request.resource.data.key is string && request.resource.data.key.size() >= 16 && request.resource.data.key.size() <= 400
        && request.resource.data.at is number;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friend requests: visible only to the two people involved. The recipient accepts or declines.
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromHandle', 'toHandle', 'createdAt'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.to)/blocks/$(request.auth.uid))
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.fromHandle is string && request.resource.data.fromHandle.size() <= 20
        && request.resource.data.toHandle is string && request.resource.data.toHandle.size() <= 20
        && request.resource.data.createdAt is number;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // A friendship exists only if the other person had sent a request that this person accepts.
    match /friendships/{pair} {
      allow read: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['a', 'b', 'ha', 'na', 'hb', 'nb', 'createdAt'])
        && request.resource.data.ha is string && request.resource.data.ha.size() <= 20 && request.resource.data.hb is string && request.resource.data.hb.size() <= 20
        && request.resource.data.na is string && request.resource.data.na.size() <= 40 && request.resource.data.nb is string && request.resource.data.nb.size() <= 40
        && request.resource.data.a < request.resource.data.b
        && pair == request.resource.data.a + '_' + request.resource.data.b
        && (request.auth.uid == request.resource.data.a || request.auth.uid == request.resource.data.b)
        && exists(/databases/$(database)/documents/requests/$((request.auth.uid == request.resource.data.a ? request.resource.data.b : request.resource.data.a) + '_' + request.auth.uid));
      allow delete: if signedIn() && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
    }

    // Private chat between two friends. The chat id is the friendship id: smaller uid + '_' + larger uid.
    function inChat(cid) { return signedIn() && request.auth.uid in cid.split('_'); }
    function friendsNow(cid) { return exists(/databases/$(database)/documents/friendships/$(cid)); }
    function validShare(p) {
      return p is map
        && p.keys().hasOnly(['type', 'id', 'title', 'year', 'poster'])
        && p.type in ['movie', 'tv'] && p.id is int
        && p.title is string && p.title.size() <= 200
        && p.year is string && p.year.size() <= 4
        && (p.poster == null || (p.poster is string && p.poster.size() <= 200 && p.poster.matches('^https://image\\.tmdb\\.org/.*')));
    }
    match /chats/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if inChat(cid) && friendsNow(cid)
        && request.resource.data.keys().hasOnly(['members', 'last', 'updatedAt', 'read'])
        && request.resource.data.members == cid.split('_')
        && request.resource.data.updatedAt is number
        && request.resource.data.read is map && request.resource.data.read.keys().hasOnly(cid.split('_'))
        && request.resource.data.last is map && request.resource.data.last.keys().hasOnly(['text', 'from', 'at'])
        && request.resource.data.last.text is string && request.resource.data.last.text.size() <= 200
        && (request.resource.data.last.from == request.auth.uid || (resource != null && request.resource.data.last == resource.data.last));
      allow delete: if false;

      match /msgs/{mid} {
        allow read: if inChat(cid);
        allow create: if inChat(cid) && friendsNow(cid)
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'share'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && request.resource.data.at is number
          && (!('share' in request.resource.data) || validShare(request.resource.data.share));
        allow delete: if inChat(cid) && resource.data.from == request.auth.uid;
      }
    }
  }
}
